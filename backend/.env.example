PORT=3000

JWT_SECRET=your_secret_key
JWT_REFRESH_SECRET=your_refresh_secret_key

DATABASE_URL=postgresql://postgres.[USER]:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:[PORT]/postgres
# COMMA-SEPARATED list of allowed browser origins. No trailing slashes (they are
# stripped anyway, but a browser's Origin header never has one).
# Production example:
#   FRONTEND_URL=https://rmit-launchpad.onrender.com,http://localhost:5173
FRONTEND_URL=http://localhost:5173
